#!/bin/bash
SIM_ROOT="${SIM_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
SIM_EVENTS="${SIM_EVENTS:-$SIM_ROOT/state/events.log}"
# deploy-sim stub for nginx: records the call; `nginx -t` exits with $SIM_NGINX_T_EXIT (default 0).
printf '%s\tnginx\t%s\n' "$(date +%s)" "$*" >> "$SIM_EVENTS"
if [[ "${1:-}" == "-t" ]]; then
    echo "nginx: configuration file (stub) test is successful" >&2
    exit "${SIM_NGINX_T_EXIT:-0}"
fi
exit 0
